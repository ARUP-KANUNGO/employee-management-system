# ===== FRONTEND (client) =====
# Base URL for the backend API. In local development with the Vite proxy, use empty string.
# In production, set to your deployed backend URL, e.g. https://your-api.onrender.com
VITE_API_URL=

# ===== BACKEND (server/.env) =====
# Copy these into server/.env and fill in real values
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/employee_management?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
